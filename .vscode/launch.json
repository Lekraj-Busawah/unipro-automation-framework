{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
 
        {
            "name": "Behave: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "behave",
            "console": "integratedTerminal",
            "args": [
                "${file}",
                "--no-capture",
                "--no-skipped",
                "--tags=@wip"
            ],
            "justMyCode": true
        },
        {
            "name": "Behave: Dry Run Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "behave",
            "console": "integratedTerminal",
            "args": [
                "${file}",
                "--tags=@wip",
                "--no-skipped",
                "--dry-run"
            ],
            "justMyCode": true
        }
    ]
}